# Ollama configuration — only needed for the --explain / "Explain findings" feature.
# Copy this file to .env (or export variables in your shell).
#
# Scenario A: Ollama running in the same environment (WSL2 or native Linux)
# OLLAMA_BASE_URL=http://localhost:11434
#
# Scenario B: Ollama on Windows, DevReady AI inside WSL2
# Find your WSL2 host IP with: ip route show default | awk '{print $3}'
# OLLAMA_BASE_URL=http://172.19.224.1:11434
#
OLLAMA_BASE_URL=http://172.19.224.1:11434
OLLAMA_MODEL=llama3.2:3b
